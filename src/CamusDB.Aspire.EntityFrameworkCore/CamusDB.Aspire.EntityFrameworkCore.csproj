<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>CamusDB.Aspire.EntityFrameworkCore</PackageId>
    <Description>Aspire client integration for the CamusDB Entity Framework Core provider: AddCamusDBDbContext() registers a pooled DbContext, with retries, health checks, tracing and metrics.</Description>
    <PackageTags>aspire;client;camusdb;database;sql;efcore;entityframework</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CamusDB.EntityFrameworkCore" Version="0.17.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
  </ItemGroup>

</Project>
