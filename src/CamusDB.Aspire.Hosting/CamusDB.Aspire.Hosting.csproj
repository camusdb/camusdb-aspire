<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>CamusDB.Aspire.Hosting</PackageId>
    <Description>Aspire hosting integration for CamusDB: AddCamusDB() runs a CamusDB server container in an Aspire AppHost, AddCamusDBCluster() runs a CamusDB cluster, and AddDatabase() creates their databases.</Description>
    <PackageTags>aspire;hosting;camusdb;database;sql;cluster;raft</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.4" />
    <PackageReference Include="CamusDB.Client" Version="0.17.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CamusDB.Aspire.Hosting.Tests" />
  </ItemGroup>

</Project>
