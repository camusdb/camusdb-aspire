<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>CamusDB.Aspire.Client</PackageId>
    <Description>Aspire client integration for CamusDB: AddCamusDBClient() registers CamusDB.Client connections in dependency injection, with health checks, tracing and metrics.</Description>
    <PackageTags>aspire;client;camusdb;database;sql;ado.net</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CamusDB.Client" Version="0.17.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
  </ItemGroup>

</Project>
